---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCldImageUrl } from 'astro-cloudinary/helpers';
import content from '../data/content.json';

const { site } = content;

const caja = [
  { peso: '2550 g', pesoPorcion: '85 g',  porciones: 30 },
  { peso: '3000 g', pesoPorcion: '100 g', porciones: 30 },
  { peso: '3450 g', pesoPorcion: '115 g', porciones: 30 },
  { peso: '3500 g', pesoPorcion: '125 g', porciones: 28 },
  { peso: '3450 g', pesoPorcion: '150 g', porciones: 23 },
  { peso: '3600 g', pesoPorcion: '100 g', porciones: 36 },
];

type Foto = { thumb: string; full: string; categoria: 'produccion' | 'hamburguesa' };

function cldFoto(nombre: string, categoria: 'produccion' | 'hamburguesa'): Foto {
  const publicId = `${nombre}.jpg`;
  return {
    thumb: getCldImageUrl({ src: publicId, width: 600, height: 450, crop: { type: 'fill', source: true }, format: 'auto', quality: 'auto' }),
    full:  getCldImageUrl({ src: publicId, width: 1600, format: 'auto', quality: 'auto' }),
    categoria,
  };
}

const fotos: Foto[] = [
  cldFoto('distri-4',  'produccion'),
  cldFoto('distri-5',  'produccion'),
  cldFoto('distri-6',  'produccion'),
  cldFoto('distri-7',  'produccion'),
  cldFoto('distri-8',  'produccion'),
  cldFoto('distri-9',  'produccion'),
  cldFoto('distri-10', 'produccion'),
  cldFoto('distri-11', 'produccion'),
  cldFoto('distri-12', 'produccion'),
  cldFoto('distri-13', 'produccion'),
  cldFoto('distri-14', 'produccion'),
  cldFoto('distri-15', 'produccion'),
  cldFoto('distri-16', 'produccion'),
  cldFoto('distri-17', 'produccion'),
];
---

<Layout title={`Catálogo de Productos — ${site.title}`} description="Catálogo de presentaciones de carne de hamburguesa artesanal premium DistriBurguer.">
  <Header />
  <main class="catalogo">

    <!-- Hero -->
    <section class="cat-hero">
      <div class="container cat-hero__inner">
        <p class="cat-hero__badge">100% CARNE DE RES</p>
        <h1 class="cat-hero__title">
          Catálogo de <span class="gold">productos</span>
        </h1>
        <p class="cat-hero__sub">
          Selecciona la presentación ideal para tu negocio y cotiza directo por WhatsApp.
        </p>
      </div>
    </section>

    <!-- Presentaciones -->
    <section class="presentaciones">
      <div class="container">
        <h2 class="section-title">Presentaciones <span class="gold">disponibles</span></h2>
        <p class="section-sub">Elige una presentación para ver los gramajes disponibles</p>

        <!-- Selectores de presentación -->
        <div class="pres-selectors" role="tablist" aria-label="Tipo de presentación">
          <button class="pres-selector pres-selector--active" role="tab" aria-selected="true" data-pres="caja">
            <div class="pres-selector__img-wrap">
              <img src="https://res.cloudinary.com/dzf4y4tbq/image/upload/v1781583403/caja_distri_n6ba0u.jpg" alt="Caja" loading="lazy" width="160" height="100" />
            </div>
            <span class="pres-selector__label">Caja</span>
          </button>
          <button class="pres-selector" role="tab" aria-selected="false" data-pres="bolsa">
            <div class="pres-selector__img-wrap">
              <img src="https://res.cloudinary.com/dzf4y4tbq/image/upload/v1781583403/bolsa_distri_ea6ddh.jpg" alt="Bolsa" loading="lazy" width="160" height="100" />
            </div>
            <span class="pres-selector__label">Bolsa de 5 unidades</span>
          </button>
        </div>

        <!-- Panel: Caja -->
        <div id="panel-caja" class="pres-panel" role="tabpanel">
          <p class="pres-panel__hint">Peso neto por empaque</p>
          <div class="pres-grid">
            {caja.map((p) => (
              <div class="pres-card">
                <div class="pres-card__peso">{p.peso}</div>
                <div class="pres-card__porcion-row">
                  <span class="pres-card__porcion-val">{p.pesoPorcion}</span>
                  <span class="pres-card__porcion-label">Peso por porción</span>
                </div>
                <div class="pres-card__porciones">
                  <span class="pres-card__num">{p.porciones}</span>
                  <span class="pres-card__label">porciones por empaque</span>
                </div>
                <a
                  href="#contacto"
                  class="pres-card__cta"
                >
                  Cotizar esta presentación
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Panel: Bolsa de 5 unidades -->
        <div id="panel-bolsa" class="pres-panel pres-panel--hidden" role="tabpanel">
          <p class="pres-panel__hint">Empaque individual de porciones</p>
          <div class="pres-grid pres-grid--centered">
            <div class="pres-card pres-card--bolsa">
              <div class="pres-card__badge">Bolsa</div>
              <div class="pres-card__peso">5 unidades</div>
              <div class="pres-card__porciones">
                <span class="pres-card__num">5</span>
                <span class="pres-card__label">porciones por empaque</span>
              </div>
              <p class="pres-card__desc">Presentación ideal para negocios que requieren porciones individuales listas para usar.</p>
              <a
                href="#contacto"
                target="_blank"
                rel="noopener noreferrer"
                class="pres-card__cta"
              >
                Cotizar esta presentación
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Galería -->
    <section class="galeria">
      <div class="container">
        <h2 class="section-title">Galería de <span class="gold">producto</span></h2>
        <p class="section-sub">Haz clic en cualquier imagen para ampliarla</p>

        <div class="galeria__grid">
          {fotos.map((foto, i) => (
            <button
              class="galeria__item"
              data-src={foto.full}
              data-index={i}
              data-cat={foto.categoria}
              aria-label={`Ver foto ${i + 1}`}
            >
              <img
                src={foto.thumb}
                alt={`DistriBurguer - ${foto.categoria === 'produccion' ? 'Foto de producción' : 'Hamburguesa preparada'} ${i + 1}`}
                loading="lazy"
                decoding="async"
                width="600"
                height="450"
              />
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Formulario de contacto -->
    <section class="cat-form" id="contacto">
      <div class="container cat-form__inner">
        <h2 class="section-title">¿Listo para <span class="gold">cotizar?</span></h2>
        <p class="section-sub">Déjanos tus datos y te contactamos con una propuesta personalizada.</p>
        <div class="cat-form__box">
          <LeadForm />
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visor de imagen">
  <button class="lightbox__close" id="lb-close" aria-label="Cerrar">&times;</button>
  <button class="lightbox__prev" id="lb-prev" aria-label="Anterior">&#8249;</button>
  <button class="lightbox__next" id="lb-next" aria-label="Siguiente">&#8250;</button>
  <div class="lightbox__content">
    <div class="lightbox__spinner" id="lb-spinner" hidden></div>
    <img src="" alt="" id="lb-img" class="lightbox__img" style="transition: opacity 0.25s;" />
  </div>
</div>

<style>
  /* ── Layout ── */
  .catalogo {
    padding-top: 72px;
  }

  .gold { color: var(--color-gold); }

  .section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 800;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 8px;
  }

  .section-sub {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: 40px;
  }

  /* ── Hero ── */
  .cat-hero {
    padding: 80px 0 60px;
    text-align: center;
    background: linear-gradient(180deg, rgba(200,148,58,0.06) 0%, transparent 100%);
    border-bottom: 1px solid rgba(200,148,58,0.12);
  }

  .cat-hero__badge {
    display: inline-block;
    background: rgba(200,148,58,0.12);
    border: 1px solid rgba(200,148,58,0.4);
    color: var(--color-gold);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 20px;
  }

  .cat-hero__title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 900;
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .cat-hero__sub {
    font-size: 1rem;
    color: var(--color-text);
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Presentaciones ── */
  .presentaciones {
    padding: 80px 0;
  }

  /* Selectores de presentación */
  .pres-selectors {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .pres-selector {
    position: relative;
    overflow: hidden;
    background: var(--color-card-bg);
    border: 2px solid var(--color-card-border);
    border-radius: 14px;
    padding: 0;
    cursor: pointer;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    width: 270px;
    height: 180px;
  }

  .pres-selector__img-wrap {
    position: absolute;
    inset: 0;
  }

  .pres-selector__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transition: transform 0.3s ease;
  }

  /* overlay permanente para legibilidad del texto */
  .pres-selector__img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.72) 0%,
      rgba(0,0,0,0.28) 50%,
      rgba(0,0,0,0.10) 100%
    );
  }

  .pres-selector:hover .pres-selector__img-wrap img {
    transform: scale(1.06);
  }

  .pres-selector__label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 14px 14px 14px;
    font-family: var(--font-main);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-white);
    text-align: center;
    transition: color 0.2s;
    z-index: 1;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
  }

  .pres-selector:hover {
    border-color: rgba(200,148,58,0.5);
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(200,148,58,0.12);
  }

  .pres-selector--active {
    border-color: rgba(200,148,58,0.85);
    box-shadow: 0 6px 24px rgba(200,148,58,0.2);
  }

  .pres-selector--active .pres-selector__label {
    color: var(--color-gold);
  }

  .pres-panel--hidden { display: none; }

  .pres-panel__hint {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: 28px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pres-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .pres-grid--centered {
    max-width: 340px;
    margin: 0 auto;
    grid-template-columns: 1fr;
  }

  .pres-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .pres-card:hover {
    border-color: rgba(200,148,58,0.5);
    transform: translateY(-3px);
  }

  .pres-card--bolsa {
    text-align: center;
    align-items: center;
  }

  .pres-card__badge {
    display: inline-block;
    background: rgba(200,148,58,0.12);
    border: 1px solid rgba(200,148,58,0.35);
    color: var(--color-gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .pres-card__peso {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-gold);
  }

  .pres-card__porcion-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(200,148,58,0.1);
  }

  .pres-card__porcion-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1;
  }

  .pres-card__porcion-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pres-card__porciones {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pres-card__num {
    font-size: 2rem;
    font-weight: 900;
    color: var(--color-white);
    line-height: 1;
  }

  .pres-card__label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pres-card__desc {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  .pres-card__cta {
    display: inline-block;
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-gold);
    border-top: 1px solid rgba(200,148,58,0.2);
    transition: color 0.2s;
  }

  .pres-card__cta:hover { color: var(--color-gold-light); }

  /* ── Galería ── */
  .galeria {
    padding: 80px 0;
    background: rgba(255,255,255,0.02);
    border-top: 1px solid rgba(200,148,58,0.08);
    border-bottom: 1px solid rgba(200,148,58,0.08);
  }

  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }

  .galeria__item {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4/3;
    position: relative;
    border: 1px solid rgba(200,148,58,0.12);
    transition: border-color 0.2s, transform 0.2s;
    background: linear-gradient(110deg, #1a1410 30%, #221a12 50%, #1a1410 70%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.4s infinite;
  }

  @keyframes skeleton-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .galeria__item.loaded {
    background: none;
    animation: none;
  }

  .galeria__item:hover {
    border-color: rgba(200,148,58,0.5);
    transform: scale(1.02);
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .galeria__item.loaded img {
    opacity: 1;
  }

  .galeria__item:hover img { opacity: 0.9; }

  /* ── Formulario catálogo ── */
  .cat-form {
    padding: 90px 0;
  }

  .cat-form__inner {
    text-align: center;
  }

  .cat-form__box {
    max-width: 780px;
    margin: 0 auto;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 16px;
    padding: 40px;
    text-align: left;
  }

  @media (max-width: 640px) {
    .cat-form__box { padding: 28px 20px; }
  }

  /* ── Lightbox ── */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0,0,0,0.92);
    align-items: center;
    justify-content: center;
  }

  .lightbox.is-open { display: flex; }

  .lightbox__content {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__img {
    max-width: 90vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 60px rgba(0,0,0,0.8);
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: absolute;
    background: rgba(200,148,58,0.15);
    border: 1px solid rgba(200,148,58,0.3);
    color: var(--color-white);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__close:hover,
  .lightbox__prev:hover,
  .lightbox__next:hover {
    background: rgba(200,148,58,0.3);
  }

  .lightbox__close { top: 20px; right: 20px; font-size: 1.4rem; }
  .lightbox__prev  { left: 20px; top: 50%; transform: translateY(-50%); }
  .lightbox__next  { right: 20px; top: 50%; transform: translateY(-50%); }

  .lightbox__spinner {
    position: absolute;
    width: 40px;
    height: 40px;
    border: 3px solid rgba(200,148,58,0.2);
    border-top-color: var(--color-gold);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 600px) {
    .pres-selectors { gap: 12px; }
    .pres-selector { width: 175px; height: 120px; }
    .pres-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .galeria__grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
    .lightbox__prev { left: 8px; }
    .lightbox__next { right: 8px; }
  }
</style>

<script>
  /* ── Selectores de presentación ── */
  const selectors = document.querySelectorAll<HTMLButtonElement>('.pres-selector');
  const panelCaja  = document.getElementById('panel-caja')!;
  const panelBolsa = document.getElementById('panel-bolsa')!;

  selectors.forEach(sel => {
    sel.addEventListener('click', () => {
      selectors.forEach(s => { s.classList.remove('pres-selector--active'); s.setAttribute('aria-selected', 'false'); });
      sel.classList.add('pres-selector--active');
      sel.setAttribute('aria-selected', 'true');

      if (sel.dataset.pres === 'caja') {
        panelCaja.classList.remove('pres-panel--hidden');
        panelBolsa.classList.add('pres-panel--hidden');
      } else {
        panelBolsa.classList.remove('pres-panel--hidden');
        panelCaja.classList.add('pres-panel--hidden');
      }
    });
  });

  /* ── Lightbox ── */
  const galeriaItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.galeria__item'));
  let current = 0;

  // Marcar imágenes como cargadas para quitar el skeleton
  galeriaItems.forEach(btn => {
    const img = btn.querySelector('img')!;
    const markLoaded = () => btn.classList.add('loaded');
    if (img.complete) markLoaded();
    else img.addEventListener('load', markLoaded);
  });

  const lightbox = document.getElementById('lightbox')!;
  const lbImg    = document.getElementById('lb-img') as HTMLImageElement;
  const lbClose  = document.getElementById('lb-close')!;
  const lbPrev   = document.getElementById('lb-prev')!;
  const lbNext   = document.getElementById('lb-next')!;
  const lbSpin   = document.getElementById('lb-spinner')!;

  function openAt(index: number) {
    current = (index + galeriaItems.length) % galeriaItems.length;
    lbImg.style.opacity = '0';
    lbSpin.hidden = false;
    lbImg.src = galeriaItems[current].dataset.src ?? '';
    lbImg.alt = `Foto ${current + 1}`;
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  lbImg.addEventListener('load', () => {
    lbSpin.hidden = true;
    lbImg.style.opacity = '1';
  });

  lbImg.addEventListener('error', () => {
    lbSpin.hidden = true;
    lbImg.style.opacity = '0.3';
  });

  function close() {
    lightbox.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  galeriaItems.forEach((btn, i) => {
    btn.addEventListener('click', () => openAt(i));
  });

  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', () => openAt(current - 1));
  lbNext.addEventListener('click', () => openAt(current + 1));
  lightbox.addEventListener('click', e => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', e => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  openAt(current - 1);
    if (e.key === 'ArrowRight') openAt(current + 1);
  });
</script>
