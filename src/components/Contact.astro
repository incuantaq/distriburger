---
import content from '../data/content.json';
import LeadForm from './LeadForm.astro';

const { contact } = content;
---

<section class="contact" id={contact.id}>
  <div class="contact__bg"></div>
  <div class="container contact__inner">

    <div class="contact__header">
      <h2 class="contact__title">{contact.title}</h2>
      <p class="contact__desc">{contact.description}</p>
    </div>

    <div class="contact__body">
      <LeadForm />
    </div>

  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: 90px 0;
    overflow: hidden;
  }

  .contact__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(200, 148, 58, 0.06) 0%, transparent 50%),
                var(--color-bg);
    z-index: 0;
  }

  .contact__inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
  }

  .contact__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .contact__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .contact__desc {
    font-size: 1.05rem;
    color: var(--color-text);
    line-height: 1.7;
  }

  .contact__body {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 16px;
    padding: 40px;
  }

  @media (max-width: 640px) {
    .contact__body { padding: 28px 20px; }
  }
</style>
