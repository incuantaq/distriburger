---
import content from '../data/content.json';
import { resolveHref } from '../utils/resolveHref';

const { footer, site } = content;
const pathname = Astro.url.pathname;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img
        src={site.logo.image}
        alt={site.logo.alt}
        class="footer__logo"
        width="200"
        height="200"
        loading="lazy"
      />
      <div>
        <p class="footer__tagline">{footer.tagline}</p>
      </div>
    </div>

    <nav class="footer__nav" aria-label="Footer navigation">
      {footer.links.map((link) => (
        <a href={resolveHref(link.href, pathname)} class="footer__nav-link">{link.text}</a>
      ))}
      <a
        href={footer.instagram.href}
        class="footer__nav-link footer__nav-link--instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.259-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.163 6.163 0 100 12.326 6.163 6.163 0 000-12.326zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        <span>{footer.instagram.text}</span>
      </a>
    </nav>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copy">{footer.copyright}</p>
      <a href={footer.privacy.href} class="footer__privacy">{footer.privacy.text}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: rgba(5, 3, 2, 0.75);
    border-top: 1px solid rgba(200, 148, 58, 0.15);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 40px;
    padding-bottom: 40px;
    gap: 32px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer__logo {
    width: 200px;
    height: 200px;
    object-fit: contain;
    border-radius: 50%;
    opacity: 0.85;
  }

  .footer__brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.2;
  }

  .footer__brand-name sup {
    font-size: 0.55em;
    color: var(--color-gold);
  }

  .footer__tagline {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .footer__nav {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer__nav-link {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    font-weight: 500;
    transition: color 0.2s;
  }

  .footer__nav-link:hover {
    color: var(--color-gold);
  }

  .footer__nav-link--instagram {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 16px 0;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px 20px;
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .footer__privacy {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 500;
    transition: color 0.2s;
  }

  .footer__privacy:hover {
    color: var(--color-gold);
  }

  @media (max-width: 600px) {
    .footer__inner {
      flex-direction: column;
      text-align: center;
    }

    .footer__brand {
      flex-direction: column;
    }

    .footer__nav {
      justify-content: center;
    }
  }
</style>
